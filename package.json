{
  "name": "resturantbilling",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wa": "node whatsapp-server/index.js",
    "dev:all": "vite & node whatsapp-server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "🚀 start": "pm2 start ecosystem.config.cjs",
    "🚀 stop": "pm2 stop mehfil-pos",
    "🚀 restart": "pm2 restart mehfil-pos",
    "🚀 logs": "pm2 logs mehfil-pos",
    "🚀 status": "pm2 status",
    "🚀 delete": "pm2 delete mehfil-pos",
    "🔄 watch": "pwsh -ExecutionPolicy Bypass -File scripts/watch-server.ps1",
    "🔄 watch:bg": "pwsh -ExecutionPolicy Bypass -File scripts/watch-server.ps1 -Background",
    "🛒 dev:persistent": "pm2 start ecosystem.config.cjs && pm2 logs mehfil-pos"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.2",
    "@capgo/capacitor-updater": "^8.51.15",
    "@tailwindcss/vite": "^4.3.3",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "compression": "^1.8.1",
    "cordova-plugin-bluetooth-serial": "^0.4.7",
    "cors": "^2.8.6",
    "expo": "^57.0.22",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "0.86.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.3.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
